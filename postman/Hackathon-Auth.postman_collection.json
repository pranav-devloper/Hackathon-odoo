{
  "info": {
    "name": "Hackathon Auth API",
    "description": "Endpoints for the FastAPI auth backend. Run in order: signup → verify-email → login → me.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "otp", "value": "" }
  ],
  "item": [
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "url": "{{base}}/auth/signup",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@test.com\",\n  \"full_name\": \"Demo User\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "Verify email",
      "request": {
        "method": "POST",
        "url": "{{base}}/auth/verify-email",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@test.com\",\n  \"code\": \"{{otp}}\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const t = pm.response.json();",
              "pm.collection.variables.set('access_token', t.access_token);",
              "pm.collection.variables.set('refresh_token', t.refresh_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base}}/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@test.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "Me (protected)",
      "request": {
        "method": "GET",
        "url": "{{base}}/auth/me",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
      }
    },
    {
      "name": "Refresh",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const t = pm.response.json();",
              "pm.collection.variables.set('access_token', t.access_token);",
              "pm.collection.variables.set('refresh_token', t.refresh_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base}}/auth/refresh",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{base}}/auth/logout",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
      }
    },
    {
      "name": "Forgot password",
      "request": {
        "method": "POST",
        "url": "{{base}}/auth/forgot-password",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@test.com\"\n}" }
      }
    },
    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "url": "{{base}}/auth/reset-password",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@test.com\",\n  \"code\": \"{{otp}}\",\n  \"new_password\": \"newsecret123\"\n}"
        }
      }
    }
  ]
}
