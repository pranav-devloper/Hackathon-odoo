# Copy to .env and adjust as needed. All values have built-in defaults.
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
FRONTEND_URL=http://localhost:8000

# ---- Email (SMTP) ----
# Leave blank to print OTPs to the server console (DEV mode, no email sent).
# For real emails, use any free SMTP resource:
#   Mailtrap sandbox -> SMTP_HOST=sandbox.smtp.mailtrap.io SMTP_PORT=587
#                        (user/pass from your Mailtrap inbox credentials)
#   Gmail app password -> SMTP_HOST=smtp.gmail.com SMTP_PORT=587
#                        SMTP_USER=you@gmail.com SMTP_PASSWORD=<app-password>
# Set SMTP_USE_SSL=true for implicit-TLS ports such as 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_FROM=AssetFlow <no-reply@assetflow.app>
